# ---- Database ----
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_dev_password

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/orderflow
SPRING_DATASOURCE_USERNAME=orderflow
SPRING_DATASOURCE_PASSWORD=orderflow_dev_password

# ---- Redis ----
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ---- Kafka ----
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- Security ----
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-generate-a-long-random-secret-before-running-in-any-shared-environment

# ---- Rate limits (requests per minute) ----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ORDER_CREATE_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=100

# ---- Payment simulator ----
PAYMENT_SIMULATION_FAILURE_RATE=0.0
PAYMENT_SIMULATION_TIMEOUT_RATE=0.0

# ---- Observability ----
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
